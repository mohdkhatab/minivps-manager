#!/usr/bin/env bash
# ==============================================================================
#                      PRIME KHATAB SERVICES • MINI-VPS
#                   Built with ❤️ by Prime Khatab
#       Customizable Virtualization, Bandwidth Quotas & Expiry Lifecycle
# ==============================================================================

set -e

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
BOLD='\033[1m'
NC='\033[0m'

CONFIG="/etc/minivps/config.json"
SUDO_CMD=""
if [ "$EUID" -ne 0 ]; then
    SUDO_CMD="sudo"
fi

get_config_val() {
    local key="$1"
    if [ -f "$CONFIG" ]; then
        jq -r "$key // empty" "$CONFIG" 2>/dev/null || true
    fi
}

get_public_ip() {
    local ip
    ip=$(curl -s4 --max-time 2 https://api.ipify.org 2>/dev/null || curl -s4 --max-time 2 https://ifconfig.me 2>/dev/null || echo "127.0.0.1")
    echo "$ip"
}

get_default_instance() {
    local def
    def=$(get_config_val '.default_instance')
    if [ -z "$def" ]; then
        def=$(get_config_val '.container_name')
    fi
    if [ -z "$def" ]; then
        def="minivps"
    fi
    echo "$def"
}

show_header() {
    local pub_ip
    pub_ip=$(get_config_val '.public_ip')
    if [ -z "$pub_ip" ] || [ "$pub_ip" = "null" ]; then
        pub_ip=$(get_public_ip)
    fi
    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}                     PRIME KHATAB SERVICES                       ${NC}"
    echo -e "${YELLOW}               Mini-VPS Virtualization & Cloud Manager           ${NC}"
    echo -e "${MAGENTA}                    Built with ❤️ by Prime Khatab                 ${NC}"
    echo -e "${BLUE}-----------------------------------------------------------------${NC}"
    echo -e " ${MAGENTA}Host Public IPv4 :${NC} ${GREEN}${pub_ip}${NC}"
    echo -e " ${MAGENTA}Virtualization   :${NC} LXD Zero-Overhead System Containers"
    echo -e " ${MAGENTA}REST API Daemon  :${NC} Active (Port $(get_config_val '.api_port' || echo "8090"))"
    echo -e "${CYAN}=================================================================${NC}"
}

cmd_list() {
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    if curl -s -f "http://127.0.0.1:$api_port/api/vps/list" -H "X-API-Key: $api_key" >/dev/null 2>&1; then
        echo -e "${CYAN}----------------------------------------------------------------------------------------------------${NC}"
        printf "${BOLD}%-15s %-10s %-8s %-12s %-20s %-16s %-14s${NC}\n" "INSTANCE" "STATUS" "PORT" "SPECS" "BANDWIDTH (USED/LIM)" "EXPIRY / REMAIN" "USER"
        echo -e "${CYAN}----------------------------------------------------------------------------------------------------${NC}"
        
        python3 -c "
import json, urllib.request
req = urllib.request.Request('http://127.0.0.1:$api_port/api/vps/list', headers={'X-API-Key': '$api_key'})
try:
    with urllib.request.urlopen(req, timeout=3) as res:
        data = json.loads(res.read().decode())
        for v in data.get('instances', []):
            name = v.get('name', '')
            st = v.get('status', '')
            port = str(v.get('ssh_port', ''))
            specs = f\"{v.get('cpu')}c/{v.get('ram')}/{v.get('storage_gb')}G\"
            bw = f\"{v.get('bandwidth',{}).get('used','0B')} / {v.get('bandwidth',{}).get('limit','Unlimited')}\"
            exp = v.get('expiry',{}).get('status_label','Unlimited')
            usr = v.get('default_user','')
            color = '\033[1;32m' if st.lower() == 'running' else '\033[1;31m'
            nc = '\033[0m'
            print(f\"{name:<15} {color}{st:<10}{nc} {port:<8} {specs:<12} {bw:<20} {exp:<16} {usr:<14}\")
except Exception as e:
    print('Failed to parse API list:', e)
"
        echo -e "${CYAN}----------------------------------------------------------------------------------------------------${NC}"
    else
        echo -e "${YELLOW}[*] Querying LXD direct instance list...${NC}"
        $SUDO_CMD lxc list -c ns46tS
    fi
}

cmd_create() {
    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}           CREATE CUSTOM MINI-VPS (QUOTA & LIFECYCLE)            ${NC}"
    echo -e "${MAGENTA}                    Built with ❤️ by Prime Khatab                 ${NC}"
    echo -e "${CYAN}=================================================================${NC}"

    local vps_name="$1"
    local vps_os="$2"
    local vps_cpu="$3"
    local vps_ram="$4"
    local vps_disk="$5"
    local vps_port="$6"
    local vps_user="$7"
    local vps_pass="$8"
    local vps_days="$9"
    local vps_bw="${10}"
    local vps_speed="${11}"

    if [ -z "$vps_name" ]; then
        read -rp " 1. Mini-VPS Instance Name [e.g. node1, client-vps]: " vps_name
        vps_name=${vps_name:-"minivps-$(date +%s | tail -c 4)"}
    fi

    if $SUDO_CMD lxc info "$vps_name" >/dev/null 2>&1; then
        echo -e "${RED}[Error] Instance '$vps_name' already exists!${NC}"
        return 1
    fi

    if [ -z "$vps_os" ]; then
        echo -e " ${YELLOW}Select OS Distribution:${NC}"
        echo "   [1] Ubuntu 22.04 LTS (Jammy) [Recommended]"
        echo "   [2] Ubuntu 24.04 LTS (Noble)"
        echo "   [3] Debian 12 (Bookworm)"
        echo "   [4] Debian 11 (Bullseye)"
        echo "   [5] Alpine Linux 3.19 (Ultra Lightweight)"
        read -rp " Select option [1-5, Default 1]: " os_choice
        case "$os_choice" in
            2) vps_os="ubuntu:24.04" ;;
            3) vps_os="images:debian/12" ;;
            4) vps_os="images:debian/11" ;;
            5) vps_os="images:alpine/3.19" ;;
            *) vps_os="ubuntu:22.04" ;;
        esac
    fi

    if [ -z "$vps_cpu" ]; then
        read -rp " 2. CPU Cores Allocation [Default: 2]: " vps_cpu
        vps_cpu=${vps_cpu:-2}
    fi

    if [ -z "$vps_ram" ]; then
        read -rp " 3. RAM Limit in GB [Default: 4]: " vps_ram
        vps_ram=${vps_ram:-4}
    fi

    if [ -z "$vps_disk" ]; then
        read -rp " 4. Dedicated Storage Quota in GB [Default: 32]: " vps_disk
        vps_disk=${vps_disk:-32}
    fi

    if [ -z "$vps_port" ]; then
        read -rp " 5. External SSH Port [Default: 2222]: " vps_port
        vps_port=${vps_port:-2222}
    fi

    if [ -z "$vps_user" ]; then
        read -rp " 6. Admin Username [Default: vpsadmin]: " vps_user
        vps_user=${vps_user:-"vpsadmin"}
    fi

    if [ -z "$vps_pass" ]; then
        read -rp " 7. Admin Password [Default: MiniVps#$(date +%Y)!]: " vps_pass
        vps_pass=${vps_pass:-"MiniVps#$(date +%Y)!"}
    fi

    if [ -z "$vps_days" ]; then
        read -rp " 8. Duration Lifespan in Days [Default: 30, 0 for Unlimited]: " vps_days
        vps_days=${vps_days:-30}
    fi

    if [ -z "$vps_bw" ]; then
        read -rp " 9. Bandwidth Quota Limit in GB [Default: 100, 0 for Unlimited]: " vps_bw
        vps_bw=${vps_bw:-100}
    fi

    if [ -z "$vps_speed" ]; then
        read -rp " 10. Bandwidth Speed Rate Limit [e.g. 50Mbit, 100Mbit, or None]: " vps_speed
        vps_speed=${vps_speed:-"None"}
    fi

    echo ""
    echo -e "${YELLOW}[*] Allocating Dedicated Storage Pool '${vps_name}-pool' (${vps_disk}GB)...${NC}"
    $SUDO_CMD lxc storage create "${vps_name}-pool" btrfs size="${vps_disk}GiB" 2>/dev/null || true

    echo -e "${YELLOW}[*] Launching Instance '$vps_name' with $vps_cpu CPUs and ${vps_ram}GB RAM...${NC}"
    $SUDO_CMD lxc launch "$vps_os" "$vps_name" \
        --storage "${vps_name}-pool" \
        -c limits.cpu="$vps_cpu" \
        -c limits.memory="${vps_ram}GiB"

    echo -e "${YELLOW}[*] Mapping External SSH Port $vps_port -> 22...${NC}"
    $SUDO_CMD lxc config device add "$vps_name" "ssh-$vps_name" proxy \
        listen="tcp:0.0.0.0:$vps_port" connect="tcp:127.0.0.1:22"

    if [ "$vps_speed" != "None" ] && [ "$vps_speed" != "0" ]; then
        echo -e "${YELLOW}[*] Setting Network Speed Limit to $vps_speed...${NC}"
        $SUDO_CMD lxc config device override "$vps_name" eth0 limits.max="$vps_speed" 2>/dev/null || true
    fi

    $SUDO_CMD lxc config set "$vps_name" boot.autostart true

    echo -e "${YELLOW}[*] Provisioning User '$vps_user' & Password Authentication...${NC}"
    sleep 3
    $SUDO_CMD lxc exec "$vps_name" -- sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true
    $SUDO_CMD lxc exec "$vps_name" -- bash -c "sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config.d/* 2>/dev/null || true"
    $SUDO_CMD lxc exec "$vps_name" -- sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null || true

    $SUDO_CMD lxc exec "$vps_name" -- useradd -m -s /bin/bash -G sudo "$vps_user" 2>/dev/null || true
    echo "$vps_user:$vps_pass" | $SUDO_CMD lxc exec "$vps_name" -- chpasswd 2>/dev/null || true
    echo "root:$vps_pass" | $SUDO_CMD lxc exec "$vps_name" -- chpasswd 2>/dev/null || true

    $SUDO_CMD lxc exec "$vps_name" -- bash -c "echo '$vps_user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/$vps_user && chmod 440 /etc/sudoers.d/$vps_user" 2>/dev/null || true
    $SUDO_CMD lxc exec "$vps_name" -- systemctl restart ssh 2>/dev/null || true

    local pub_ip
    pub_ip=$(get_public_ip)
    $SUDO_CMD python3 -c "
import json, os
from datetime import datetime, timedelta

cfg_path = '$CONFIG'
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
data = {}
if os.path.exists(cfg_path):
    with open(cfg_path) as f:
        data = json.load(f)

instances = data.setdefault('instances', {})
now = datetime.utcnow()
days = int('$vps_days')
exp_str = (now + timedelta(days=days)).isoformat() + 'Z' if days > 0 else None

instances['$vps_name'] = {
    'name': '$vps_name',
    'os': '$vps_os',
    'cpu': int('$vps_cpu'),
    'ram': '${vps_ram}GiB',
    'storage_gb': int('$vps_disk'),
    'storage_pool': '${vps_name}-pool',
    'ssh_port': int('$vps_port'),
    'default_user': '$vps_user',
    'duration_days': days,
    'bandwidth_limit_gb': float('$vps_bw'),
    'speed_limit': '$vps_speed',
    'created_at': now.isoformat() + 'Z',
    'expires_at': exp_str
}
data['public_ip'] = '$pub_ip'
if not data.get('default_instance'):
    data['default_instance'] = '$vps_name'
with open(cfg_path, 'w') as f:
    json.dump(data, f, indent=2)
os.chmod(cfg_path, 0o644)
" 2>/dev/null || true

    echo ""
    echo -e "${GREEN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}           [✓] MINI-VPS INSTANCE CREATED SUCCESSFULLY!           ${NC}"
    echo -e "${MAGENTA}                    Built with ❤️ by Prime Khatab                 ${NC}"
    echo -e "${GREEN}=================================================================${NC}"
    echo -e " ${YELLOW}Instance Name   :${NC} $vps_name"
    echo -e " ${YELLOW}Host Public IP  :${NC} $pub_ip"
    echo -e " ${YELLOW}SSH Port        :${NC} $vps_port"
    echo -e " ${YELLOW}Username        :${NC} $vps_user (or root)"
    echo -e " ${YELLOW}Password        :${NC} $vps_pass"
    echo -e " ${YELLOW}Specifications  :${NC} ${vps_cpu} CPU(s) | ${vps_ram}GB RAM | ${vps_disk}GB Storage"
    echo -e " ${YELLOW}Lifespan (Days) :${NC} ${vps_days} days $([ "$vps_days" -eq 0 ] && echo "(Unlimited)" || echo "")"
    echo -e " ${YELLOW}Bandwidth Quota :${NC} ${vps_bw} GB $([ "$vps_bw" -eq 0 ] && echo "(Unlimited)" || echo "")"
    echo -e " ${YELLOW}Speed Rate      :${NC} $vps_speed"
    echo -e "${CYAN}-----------------------------------------------------------------${NC}"
    echo -e " ${YELLOW}SSH Connect     :${NC} ${GREEN}ssh -p $vps_port $vps_user@$pub_ip${NC}"
    echo -e " ${YELLOW}Direct Shell    :${NC} minivps shell $vps_name"
    echo -e "${GREEN}=================================================================${NC}"
}

cmd_info() {
    local target="${1:-$(get_default_instance)}"
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    if curl -s -f "http://127.0.0.1:$api_port/api/vps/$target/info" -H "X-API-Key: $api_key" >/dev/null 2>&1; then
        python3 -c "
import json, urllib.request
req = urllib.request.Request('http://127.0.0.1:$api_port/api/vps/$target/info', headers={'X-API-Key': '$api_key'})
try:
    with urllib.request.urlopen(req, timeout=3) as res:
        d = json.loads(res.read().decode())
        name = d.get('name')
        ip = d.get('public_ip')
        port = d.get('ssh_port')
        usr = d.get('default_user')
        cmd = d.get('ssh_command')
        specs = d.get('specs', {})
        bw = d.get('bandwidth', {})
        exp = d.get('expiry', {})
        
        print('\033[1;36m=================================================================\033[0m')
        print(f'\033[1;32m\033[1m              MINI-VPS COMPLETE DETAILS: \033[1;33m{name}\033[0m')
        print('\033[1;35m                    Built with ❤️ by Prime Khatab                 \033[0m')
        print('\033[1;36m=================================================================\033[0m')
        print(f' \033[1;33mInstance Name   :\033[0m {name}')
        print(f' \033[1;33mHost Public IP  :\033[0m {ip}')
        print(f' \033[1;33mSSH Port        :\033[0m {port}')
        print(f' \033[1;33mAdmin Username  :\033[0m {usr} (or root)')
        print(f' \033[1;33mHardware Specs  :\033[0m {specs.get(\"cpu\")} vCPUs | {specs.get(\"ram\")} RAM | {specs.get(\"storage_gb\")}GB Storage')
        print(f' \033[1;33mOS Distribution :\033[0m {specs.get(\"os\")}')
        print('\033[1;34m-----------------------------------------------------------------\033[0m')
        print(f' \033[1;35mBandwidth Consumed :\033[0m \033[1;32m{bw.get(\"total_human\")}\033[0m (RX: {bw.get(\"rx_human\")}, TX: {bw.get(\"tx_human\")})')
        print(f' \033[1;35mBandwidth Quota    :\033[0m {bw.get(\"limit_human\")} ({bw.get(\"usage_percent\", 0)}% used)')
        print(f' \033[1;35mBandwidth Left     :\033[0m {bw.get(\"remaining_human\")}')
        print('\033[1;34m-----------------------------------------------------------------\033[0m')
        print(f' \033[1;33mLifespan Created   :\033[0m {exp.get(\"created_at\")}')
        print(f' \033[1;33mExpiration Date    :\033[0m {exp.get(\"expires_at\")}')
        print(f' \033[1;33mDays Remaining     :\033[0m \033[1;32m{exp.get(\"status_label\")}\033[0m')
        print('\033[1;34m-----------------------------------------------------------------\033[0m')
        print(f' \033[1;33mSSH Connection     :\033[0m \033[1;32m{cmd}\033[0m')
        print(f' \033[1;33mDirect Shell       :\033[0m minivps shell {name}')
        print(f' \033[1;33mREST API Endpoint  :\033[0m http://{ip}:$api_port/api/vps/{name}/status')
        print('\033[1;36m=================================================================\033[0m')
except Exception as e:
    print('Failed to load info:', e)
"
    else
        echo -e "${RED}[Error] Could not retrieve info for '$target'. Check if API is running.${NC}"
    fi
}

cmd_status() {
    local target="${1:-$(get_default_instance)}"
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    if curl -s -f "http://127.0.0.1:$api_port/api/vps/$target/status" -H "X-API-Key: $api_key" >/dev/null 2>&1; then
        curl -s -H "X-API-Key: $api_key" "http://127.0.0.1:$api_port/api/vps/$target/status" | jq .
    else
        $SUDO_CMD lxc info "$target"
    fi
}

cmd_renew() {
    local target="${1:-$(get_default_instance)}"
    local days="$2"
    if [ -z "$days" ]; then
        read -rp "Enter number of days to extend for '$target' [e.g. 30]: " days
        days=${days:-30}
    fi

    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    echo -e "${YELLOW}[*] Extending lifespan of '$target' by $days days...${NC}"
    curl -s -X POST -H "X-API-Key: $api_key" -H "Content-Type: application/json" \
         -d "{\"days\": $days}" \
         "http://127.0.0.1:$api_port/api/vps/$target/renew" | jq .
}

cmd_set_limit() {
    local target="${1:-$(get_default_instance)}"
    local quota_gb="$2"
    local speed="$3"

    if [ -z "$quota_gb" ]; then
        read -rp "Enter new Bandwidth Quota in GB [e.g. 200, 0 for Unlimited]: " quota_gb
    fi
    if [ -z "$speed" ]; then
        read -rp "Enter Speed Rate Limit [e.g. 50Mbit, 100Mbit, or none]: " speed
    fi

    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    curl -s -X POST -H "X-API-Key: $api_key" -H "Content-Type: application/json" \
         -d "{\"bandwidth_limit_gb\": $quota_gb, \"speed_limit\": \"$speed\"}" \
         "http://127.0.0.1:$api_port/api/vps/$target/limit" | jq .
}

cmd_auto_clean() {
    local del_mode="$1"
    local is_del="false"
    if [ "$del_mode" = "--delete" ] || [ "$del_mode" = "-d" ]; then
        is_del="true"
        echo -e "${RED}[!] WARNING: Permanent deletion mode active for expired instances.${NC}"
    fi

    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    echo -e "${YELLOW}[*] Scanning and enforcing quotas & expiration...${NC}"
    curl -s -X POST -H "X-API-Key: $api_key" "http://127.0.0.1:$api_port/api/vps/auto-clean?delete_expired=$is_del" | jq .
}

cmd_shell() {
    local target="${1:-$(get_default_instance)}"
    local def_user
    def_user=$(get_config_val ".instances.\"$target\".default_user")
    if [ -z "$def_user" ]; then def_user="vpsadmin"; fi

    echo -e "${GREEN}[*] Attaching to '$target' as user '$def_user'...${NC}"
    $SUDO_CMD lxc exec "$target" -- su - "$def_user" 2>/dev/null || $SUDO_CMD lxc exec "$target" -- bash
}

cmd_start() {
    local target="${1:-$(get_default_instance)}"
    echo -e "${YELLOW}[*] Starting Mini-VPS '$target'...${NC}"
    $SUDO_CMD lxc start "$target" && echo -e "${GREEN}[✓] '$target' started successfully.${NC}"
}

cmd_stop() {
    local target="${1:-$(get_default_instance)}"
    echo -e "${YELLOW}[*] Stopping Mini-VPS '$target'...${NC}"
    $SUDO_CMD lxc stop "$target" && echo -e "${GREEN}[✓] '$target' stopped successfully.${NC}"
}

cmd_restart() {
    local target="${1:-$(get_default_instance)}"
    echo -e "${YELLOW}[*] Restarting Mini-VPS '$target'...${NC}"
    $SUDO_CMD lxc restart "$target" && echo -e "${GREEN}[✓] '$target' restarted successfully.${NC}"
}

cmd_delete() {
    local target="$1"
    if [ -z "$target" ]; then
        read -rp "Enter name of Mini-VPS to permanently delete: " target
    fi
    if [ -z "$target" ]; then
        echo -e "${RED}[Error] Target name cannot be empty.${NC}"
        return 1
    fi

    echo -e "${RED}[!] WARNING: This will permanently destroy container '$target' and all its data!${NC}"
    read -rp "Are you sure? (y/N): " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}[*] Deleting container and storage pool...${NC}"
        $SUDO_CMD lxc stop "$target" --force 2>/dev/null || true
        $SUDO_CMD lxc delete "$target" 2>/dev/null || true
        $SUDO_CMD lxc storage delete "${target}-pool" 2>/dev/null || true

        $SUDO_CMD python3 -c "
import json, os
cfg = '$CONFIG'
if os.path.exists(cfg):
    with open(cfg) as f:
        d = json.load(f)
    if '$target' in d.get('instances', {}):
        del d['instances']['$target']
    with open(cfg, 'w') as f:
        json.dump(d, f, indent=2)
" 2>/dev/null || true
        echo -e "${GREEN}[✓] Mini-VPS '$target' deleted successfully.${NC}"
    else
        echo "Aborted."
    fi
}

cmd_passwd() {
    local target="${1:-$(get_default_instance)}"
    local user="$2"
    local pass="$3"

    if [ -z "$user" ]; then
        read -rp "Enter username in '$target' [e.g. vpsadmin, root]: " user
    fi
    if [ -z "$pass" ]; then
        read -rp "Enter new password for '$user': " pass
    fi

    echo "$user:$pass" | $SUDO_CMD lxc exec "$target" -- chpasswd
    echo -e "${GREEN}[✓] Password for user '$user' in '$target' updated successfully.${NC}"
}

cmd_api() {
    local pub_ip
    pub_ip=$(get_config_val '.public_ip')
    if [ -z "$pub_ip" ]; then pub_ip=$(get_public_ip); fi
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")
    local def_target
    def_target=$(get_default_instance)

    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}                    MINI-VPS REST API GUIDE                      ${NC}"
    echo -e "${MAGENTA}                    Built with ❤️ by Prime Khatab                 ${NC}"
    echo -e "${CYAN}=================================================================${NC}"
    echo -e " ${YELLOW}Base URL        :${NC} http://$pub_ip:$api_port"
    echo -e " ${YELLOW}Interactive Docs:${NC} http://$pub_ip:$api_port/docs"
    echo -e " ${YELLOW}API Key         :${NC} ${GREEN}$api_key${NC}"
    echo -e "${BLUE}-----------------------------------------------------------------${NC}"
    echo -e " ${MAGENTA}cURL Examples:${NC}"
    echo ""
    echo -e " 1. List all instances (with Bandwidth & Expiry):"
    echo "    curl -H \"X-API-Key: $api_key\" http://$pub_ip:$api_port/api/vps/list"
    echo ""
    echo -e " 2. Get status of '$def_target':"
    echo "    curl -H \"X-API-Key: $api_key\" http://$pub_ip:$api_port/api/vps/$def_target/status"
    echo ""
    echo -e " 3. Renew / Extend Duration by 30 days:"
    echo "    curl -X POST -H \"X-API-Key: $api_key\" -H \"Content-Type: application/json\" \\"
    echo "         -d '{\"days\": 30}' \\"
    echo "         http://$pub_ip:$api_port/api/vps/$def_target/renew"
    echo ""
    echo -e " 4. Update Bandwidth Quota & Speed Rate:"
    echo "    curl -X POST -H \"X-API-Key: $api_key\" -H \"Content-Type: application/json\" \\"
    echo "         -d '{\"bandwidth_limit_gb\": 150, \"speed_limit\": \"50Mbit\"}' \\"
    echo "         http://$pub_ip:$api_port/api/vps/$def_target/limit"
    echo ""
    echo -e " 5. Create a brand new Mini-VPS via API:"
    echo "    curl -X POST -H \"X-API-Key: $api_key\" -H \"Content-Type: application/json\" \\"
    echo "         -d '{\"name\":\"node2\", \"cpu\":2, \"ram_gb\":4, \"storage_gb\":32, \"ssh_port\":2225, \"username\":\"admin\", \"password\":\"Pass123!\", \"duration_days\":30, \"bandwidth_limit_gb\":100}' \\"
    echo "         http://$pub_ip:$api_port/api/vps/create"
    echo -e "${CYAN}=================================================================${NC}"
}

cmd_menu() {
    while true; do
        clear
        show_header
        echo -e " ${YELLOW}[1]${NC}  Create New Mini-VPS ${GREEN}(Custom Specs, Bandwidth Quota, Lifespan)${NC}"
        echo -e " ${YELLOW}[2]${NC}  List All Mini-VPS Instances ${GREEN}(Live Bandwidth & Expiry)${NC}"
        echo -e " ${YELLOW}[3]${NC}  Mini-VPS Information & Credentials"
        echo -e " ${YELLOW}[4]${NC}  Live Status & Resource Statistics ${GREEN}(RAM/CPU/Disk/Bandwidth)${NC}"
        echo -e " ${YELLOW}[5]${NC}  1-Click Shell Login ${GREEN}(Direct Terminal Inside VPS)${NC}"
        echo -e "${BLUE}-----------------------------------------------------------------${NC}"
        echo -e " ${YELLOW}[6]${NC}  Start Mini-VPS"
        echo -e " ${YELLOW}[7]${NC}  Stop Mini-VPS"
        echo -e " ${YELLOW}[8]${NC}  Restart Mini-VPS"
        echo -e " ${YELLOW}[9]${NC}  Renew / Extend Mini-VPS Duration ${GREEN}(Add Days)${NC}"
        echo -e " ${YELLOW}[10]${NC} Set / Change Bandwidth Quota & Speed Limit"
        echo -e "${BLUE}-----------------------------------------------------------------${NC}"
        echo -e " ${YELLOW}[11]${NC} Change User Password"
        echo -e " ${YELLOW}[12]${NC} Execute Command inside Mini-VPS"
        echo -e " ${YELLOW}[13]${NC} Auto-Clean Expired Instances ${RED}(Scan / Suspend / Prune)${NC}"
        echo -e " ${YELLOW}[14]${NC} Delete Mini-VPS Instance & Free Storage"
        echo -e " ${YELLOW}[15]${NC} Show REST API Details & cURL Documentation"
        echo -e " ${YELLOW}[0]${NC}  Exit Menu"
        echo -e "${CYAN}=================================================================${NC}"
        echo -e " ${MAGENTA}Prime Khatab Services${NC} • Built with ❤️ by Prime Khatab"
        echo -e "${CYAN}=================================================================${NC}"
        read -rp " Select Option [0-15]: " opt

        case "$opt" in
            1)
                echo ""
                cmd_create
                read -rp " Press [Enter] to continue..."
                ;;
            2)
                echo ""
                cmd_list
                read -rp " Press [Enter] to continue..."
                ;;
            3)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_info "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            4)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_status "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            5)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_shell "${tname:-$(get_default_instance)}"
                ;;
            6)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_start "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            7)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_stop "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            8)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_restart "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            9)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_renew "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            10)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_set_limit "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            11)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_passwd "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            12)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                read -rp " Enter command to run: " cmd_run
                $SUDO_CMD lxc exec "${tname:-$(get_default_instance)}" -- bash -c "$cmd_run"
                read -rp " Press [Enter] to continue..."
                ;;
            13)
                echo ""
                read -rp " Do you want to permanently delete expired instances? (y/N): " del_exp
                if [[ "$del_exp" =~ ^[Yy]$ ]]; then
                    cmd_auto_clean "--delete"
                else
                    cmd_auto_clean
                fi
                read -rp " Press [Enter] to continue..."
                ;;
            14)
                echo ""
                cmd_delete
                read -rp " Press [Enter] to continue..."
                ;;
            15)
                echo ""
                cmd_api
                read -rp " Press [Enter] to continue..."
                ;;
            0)
                echo ""
                echo -e "${GREEN}Thank you for choosing Prime Khatab Services! Have a great day!${NC}"
                break
                ;;
            *)
                echo -e "${RED}Invalid choice!${NC}"
                sleep 1
                ;;
        esac
    done
}

case "$1" in
    list|ls)
        cmd_list
        ;;
    create|add|new)
        shift
        cmd_create "$@"
        ;;
    info|show)
        cmd_info "$2"
        ;;
    status)
        cmd_status "$2"
        ;;
    renew|extend)
        cmd_renew "$2" "$3"
        ;;
    limit|set-limit)
        cmd_set_limit "$2" "$3" "$4"
        ;;
    auto-clean|clean|prune)
        cmd_auto_clean "$2"
        ;;
    shell|ssh|login)
        cmd_shell "$2"
        ;;
    start)
        cmd_start "$2"
        ;;
    stop)
        cmd_stop "$2"
        ;;
    restart|reboot)
        cmd_restart "$2"
        ;;
    delete|rm|destroy)
        cmd_delete "$2"
        ;;
    passwd|password)
        cmd_passwd "$2" "$3" "$4"
        ;;
    exec)
        shift
        target="${1:-$(get_default_instance)}"
        shift
        $SUDO_CMD lxc exec "$target" -- bash -c "$*"
        ;;
    api)
        cmd_api
        ;;
    menu)
        cmd_menu
        ;;
    version|-v|--version)
        echo "Prime Khatab Mini-VPS Manager CLI v2.1.0 (Built with ❤️ by Prime Khatab)"
        ;;
    help|-h|--help)
        echo "Prime Khatab Mini-VPS Manager (Built with ❤️ by Prime Khatab)"
        echo "Usage: minivps [command] [args...]"
        echo ""
        echo "Commands:"
        echo "  menu                          Launch interactive management TUI"
        echo "  list                          List all active Mini-VPS instances with bandwidth & expiry"
        echo "  create [args...]              Provision custom Mini-VPS with bandwidth quota & lifespan"
        echo "  info [name]                   Show detailed specs, bandwidth metrics & credentials"
        echo "  status [name]                 Live CPU, RAM, Disk, and Bandwidth metrics"
        echo "  renew [name] [days]           Extend lifespan duration by X days"
        echo "  limit [name] [quota_gb] [spd] Set bandwidth quota and speed rate limit"
        echo "  auto-clean [--delete]         Check and suspend or prune expired instances"
        echo "  shell [name]                  Direct 1-click shell login into Mini-VPS"
        echo "  start [name]                  Start Mini-VPS"
        echo "  stop [name]                   Stop Mini-VPS"
        echo "  restart [name]                Restart Mini-VPS"
        echo "  passwd [name] [usr] [pwd]     Update user password"
        echo "  exec [name] \"command\"         Execute command inside Mini-VPS"
        echo "  delete [name]                 Delete Mini-VPS and free storage pool"
        echo "  api                           Display REST API documentation and cURL examples"
        ;;
    *)
        cmd_menu
        ;;
esac
