#!/usr/bin/env bash
# ==============================================================================
#                  MINI VPS MANAGER - CLI & INTERACTIVE TUI
#              Created & Managed for: High-Performance Multi-VPS
# ==============================================================================

set -e

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
BOLD='\033[1m'
NC='\033[0m'

CONFIG="/etc/minivps/config.json"

check_root_or_sudo() {
    if [ "$EUID" -ne 0 ] && ! command -v sudo >/dev/null 2>&1; then
        echo -e "${RED}[Error] This script requires root or sudo privileges.${NC}"
        exit 1
    fi
}

SUDO_CMD=""
if [ "$EUID" -ne 0 ]; then
    SUDO_CMD="sudo"
fi

get_config_val() {
    local key="$1"
    if [ -f "$CONFIG" ]; then
        jq -r "$key // empty" "$CONFIG" 2>/dev/null || true
    fi
}

get_public_ip() {
    local ip
    ip=$(curl -s4 --max-time 2 https://api.ipify.org 2>/dev/null || curl -s4 --max-time 2 https://ifconfig.me 2>/dev/null || echo "127.0.0.1")
    echo "$ip"
}

get_default_instance() {
    local def
    def=$(get_config_val '.default_instance')
    if [ -z "$def" ]; then
        def=$(get_config_val '.container_name')
    fi
    if [ -z "$def" ]; then
        def="minivps"
    fi
    echo "$def"
}

show_header() {
    local pub_ip
    pub_ip=$(get_config_val '.public_ip')
    if [ -z "$pub_ip" ] || [ "$pub_ip" = "null" ]; then
        pub_ip=$(get_public_ip)
    fi
    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}                     MINI-VPS MANAGER SUITE                      ${NC}"
    echo -e "${YELLOW}           Customizable Virtual Environment & REST API           ${NC}"
    echo -e "${BLUE}-----------------------------------------------------------------${NC}"
    echo -e " ${MAGENTA}Host Public IPv4 :${NC} ${GREEN}${pub_ip}${NC}"
    echo -e " ${MAGENTA}Virtualization   :${NC} LXD System Containers (Zero-Overhead)"
    echo -e " ${MAGENTA}REST API Service :${NC} Active (Port $(get_config_val '.api_port' || echo "8090"))"
    echo -e "${CYAN}=================================================================${NC}"
}

cmd_list() {
    echo -e "${CYAN}--- Active Mini-VPS Instances ---${NC}"
    $SUDO_CMD lxc list -c ns46tS
}

cmd_create() {
    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}              CREATE NEW CUSTOM MINI-VPS INSTANCE                ${NC}"
    echo -e "${CYAN}=================================================================${NC}"

    local vps_name="$1"
    local vps_os="$2"
    local vps_cpu="$3"
    local vps_ram="$4"
    local vps_disk="$5"
    local vps_port="$6"
    local vps_user="$7"
    local vps_pass="$8"

    # Interactive prompts if arguments omitted
    if [ -z "$vps_name" ]; then
        read -rp " 1. Mini-VPS Instance Name [e.g. node1, minivps, client1]: " vps_name
        vps_name=${vps_name:-"minivps-$(date +%s | tail -c 4)"}
    fi

    # Check if instance already exists
    if $SUDO_CMD lxc info "$vps_name" >/dev/null 2>&1; then
        echo -e "${RED}[Error] Instance '$vps_name' already exists!${NC}"
        return 1
    fi

    if [ -z "$vps_os" ]; then
        echo -e " ${YELLOW}Select OS Distribution:${NC}"
        echo "   [1] Ubuntu 22.04 LTS (Jammy) [Recommended]"
        echo "   [2] Ubuntu 24.04 LTS (Noble)"
        echo "   [3] Debian 12 (Bookworm)"
        echo "   [4] Debian 11 (Bullseye)"
        echo "   [5] Alpine Linux 3.19 (Ultra Lightweight)"
        read -rp " Select option [1-5, Default 1]: " os_choice
        case "$os_choice" in
            2) vps_os="ubuntu:24.04" ;;
            3) vps_os="images:debian/12" ;;
            4) vps_os="images:debian/11" ;;
            5) vps_os="images:alpine/3.19" ;;
            *) vps_os="ubuntu:22.04" ;;
        esac
    fi

    if [ -z "$vps_cpu" ]; then
        read -rp " 2. CPU Cores Allocation [Default: 2]: " vps_cpu
        vps_cpu=${vps_cpu:-2}
    fi

    if [ -z "$vps_ram" ]; then
        read -rp " 3. RAM Limit in GB [Default: 4]: " vps_ram
        vps_ram=${vps_ram:-4}
    fi

    if [ -z "$vps_disk" ]; then
        read -rp " 4. Dedicated Storage Limit in GB [Default: 32]: " vps_disk
        vps_disk=${vps_disk:-32}
    fi

    if [ -z "$vps_port" ]; then
        read -rp " 5. External SSH Port [Default: 2222]: " vps_port
        vps_port=${vps_port:-2222}
    fi

    if [ -z "$vps_user" ]; then
        read -rp " 6. Admin Username [Default: vpsadmin]: " vps_user
        vps_user=${vps_user:-"vpsadmin"}
    fi

    if [ -z "$vps_pass" ]; then
        read -rp " 7. Admin Password [Default: MiniVps#$(date +%Y)!]: " vps_pass
        vps_pass=${vps_pass:-"MiniVps#$(date +%Y)!"}
    fi

    echo ""
    echo -e "${YELLOW}[*] Creating Storage Pool '${vps_name}-pool' (${vps_disk}GB)...${NC}"
    $SUDO_CMD lxc storage create "${vps_name}-pool" btrfs size="${vps_disk}GiB" 2>/dev/null || true

    echo -e "${YELLOW}[*] Launching Instance '$vps_name' with $vps_cpu CPUs and ${vps_ram}GB RAM...${NC}"
    $SUDO_CMD lxc launch "$vps_os" "$vps_name" \
        --storage "${vps_name}-pool" \
        -c limits.cpu="$vps_cpu" \
        -c limits.memory="${vps_ram}GiB"

    echo -e "${YELLOW}[*] Configuring External SSH Proxy on Port $vps_port...${NC}"
    $SUDO_CMD lxc config device add "$vps_name" "ssh-$vps_name" proxy \
        listen="tcp:0.0.0.0:$vps_port" connect="tcp:127.0.0.1:22"

    echo -e "${YELLOW}[*] Setting Autostart on Boot...${NC}"
    $SUDO_CMD lxc config set "$vps_name" boot.autostart true

    echo -e "${YELLOW}[*] Configuring User '$vps_user' and SSH Password Authentication...${NC}"
    sleep 3
    $SUDO_CMD lxc exec "$vps_name" -- sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true
    $SUDO_CMD lxc exec "$vps_name" -- bash -c "sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config.d/* 2>/dev/null || true"
    $SUDO_CMD lxc exec "$vps_name" -- sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null || true

    # User creation
    $SUDO_CMD lxc exec "$vps_name" -- useradd -m -s /bin/bash -G sudo "$vps_user" 2>/dev/null || true
    echo "$vps_user:$vps_pass" | $SUDO_CMD lxc exec "$vps_name" -- chpasswd 2>/dev/null || true
    echo "root:$vps_pass" | $SUDO_CMD lxc exec "$vps_name" -- chpasswd 2>/dev/null || true

    $SUDO_CMD lxc exec "$vps_name" -- bash -c "echo '$vps_user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/$vps_user && chmod 440 /etc/sudoers.d/$vps_user" 2>/dev/null || true
    $SUDO_CMD lxc exec "$vps_name" -- systemctl restart ssh 2>/dev/null || true

    # Update config JSON
    local pub_ip
    pub_ip=$(get_public_ip)
    $SUDO_CMD python3 -c "
import json, os
cfg_path = '$CONFIG'
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
data = {}
if os.path.exists(cfg_path):
    with open(cfg_path) as f:
        data = json.load(f)
instances = data.setdefault('instances', {})
instances['$vps_name'] = {
    'name': '$vps_name',
    'os': '$vps_os',
    'cpu': $vps_cpu,
    'ram': '${vps_ram}GiB',
    'storage_gb': $vps_disk,
    'storage_pool': '${vps_name}-pool',
    'ssh_port': $vps_port,
    'default_user': '$vps_user'
}
data['public_ip'] = '$pub_ip'
if not data.get('default_instance'):
    data['default_instance'] = '$vps_name'
with open(cfg_path, 'w') as f:
    json.dump(data, f, indent=2)
os.chmod(cfg_path, 0o644)
" 2>/dev/null || true

    echo ""
    echo -e "${GREEN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}           [✓] MINI-VPS INSTANCE CREATED SUCCESSFULLY!           ${NC}"
    echo -e "${GREEN}=================================================================${NC}"
    echo -e " ${YELLOW}Instance Name :${NC} $vps_name"
    echo -e " ${YELLOW}Public IP     :${NC} $pub_ip"
    echo -e " ${YELLOW}SSH Port      :${NC} $vps_port"
    echo -e " ${YELLOW}Username      :${NC} $vps_user (or root)"
    echo -e " ${YELLOW}Password      :${NC} $vps_pass"
    echo -e " ${YELLOW}Specs         :${NC} ${vps_cpu} CPU(s) | ${vps_ram}GB RAM | ${vps_disk}GB Storage"
    echo -e "${CYAN}-----------------------------------------------------------------${NC}"
    echo -e " ${YELLOW}SSH Connect   :${NC} ${GREEN}ssh -p $vps_port $vps_user@$pub_ip${NC}"
    echo -e " ${YELLOW}Shell Connect :${NC} minivps shell $vps_name"
    echo -e "${GREEN}=================================================================${NC}"
}

cmd_info() {
    local target="${1:-$(get_default_instance)}"
    local pub_ip
    pub_ip=$(get_config_val '.public_ip')
    if [ -z "$pub_ip" ]; then pub_ip=$(get_public_ip); fi
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")

    local ssh_port
    ssh_port=$(get_config_val ".instances.\"$target\".ssh_port")
    if [ -z "$ssh_port" ]; then ssh_port="2222"; fi

    local def_user
    def_user=$(get_config_val ".instances.\"$target\".default_user")
    if [ -z "$def_user" ]; then def_user="vpsadmin"; fi

    local cpu
    cpu=$(get_config_val ".instances.\"$target\".cpu")
    local ram
    ram=$(get_config_val ".instances.\"$target\".ram")
    local disk
    disk=$(get_config_val ".instances.\"$target\".storage_gb")

    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}               MINI-VPS DETAILS: ${YELLOW}$target${NC}"
    echo -e "${CYAN}=================================================================${NC}"
    echo -e " ${YELLOW}Instance Name  :${NC} $target"
    echo -e " ${YELLOW}Host Public IP :${NC} $pub_ip"
    echo -e " ${YELLOW}SSH Port       :${NC} $ssh_port"
    echo -e " ${YELLOW}Username       :${NC} $def_user (or root)"
    echo -e " ${YELLOW}Specifications :${NC} ${cpu:-2} vCPUs | ${ram:-4GB} RAM | ${disk:-32}GB Storage"
    echo -e "${BLUE}-----------------------------------------------------------------${NC}"
    echo -e " ${YELLOW}SSH Command    :${NC} ${GREEN}ssh -p $ssh_port $def_user@$pub_ip${NC}"
    echo -e " ${YELLOW}Direct Shell   :${NC} minivps shell $target"
    echo -e "${BLUE}-----------------------------------------------------------------${NC}"
    echo -e " ${YELLOW}REST API Base  :${NC} http://$pub_ip:$api_port"
    echo -e " ${YELLOW}Swagger Docs   :${NC} http://$pub_ip:$api_port/docs"
    echo -e " ${YELLOW}API Key        :${NC} ${GREEN}$api_key${NC}"
    echo -e "${CYAN}=================================================================${NC}"
}

cmd_status() {
    local target="${1:-$(get_default_instance)}"
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")
    
    if curl -s -f "http://127.0.0.1:$api_port/api/vps/$target/status" -H "X-API-Key: $api_key" >/dev/null 2>&1; then
        curl -s -H "X-API-Key: $api_key" "http://127.0.0.1:$api_port/api/vps/$target/status" | jq .
    else
        echo -e "${YELLOW}[*] Querying LXD directly for '$target'...${NC}"
        $SUDO_CMD lxc info "$target"
    fi
}

cmd_shell() {
    local target="${1:-$(get_default_instance)}"
    local def_user
    def_user=$(get_config_val ".instances.\"$target\".default_user")
    if [ -z "$def_user" ]; then def_user="vpsadmin"; fi

    echo -e "${GREEN}[*] Attaching to '$target' as user '$def_user'...${NC}"
    $SUDO_CMD lxc exec "$target" -- su - "$def_user" 2>/dev/null || $SUDO_CMD lxc exec "$target" -- bash
}

cmd_start() {
    local target="${1:-$(get_default_instance)}"
    echo -e "${YELLOW}[*] Starting Mini-VPS '$target'...${NC}"
    $SUDO_CMD lxc start "$target" && echo -e "${GREEN}[✓] '$target' started successfully.${NC}"
}

cmd_stop() {
    local target="${1:-$(get_default_instance)}"
    echo -e "${YELLOW}[*] Stopping Mini-VPS '$target'...${NC}"
    $SUDO_CMD lxc stop "$target" && echo -e "${GREEN}[✓] '$target' stopped successfully.${NC}"
}

cmd_restart() {
    local target="${1:-$(get_default_instance)}"
    echo -e "${YELLOW}[*] Restarting Mini-VPS '$target'...${NC}"
    $SUDO_CMD lxc restart "$target" && echo -e "${GREEN}[✓] '$target' restarted successfully.${NC}"
}

cmd_delete() {
    local target="$1"
    if [ -z "$target" ]; then
        read -rp "Enter name of Mini-VPS to permanently delete: " target
    fi
    if [ -z "$target" ]; then
        echo -e "${RED}[Error] Target name cannot be empty.${NC}"
        return 1
    fi

    echo -e "${RED}[!] WARNING: This will permanently delete container '$target' and all its data!${NC}"
    read -rp "Are you sure? (y/N): " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}[*] Deleting container and storage pool...${NC}"
        $SUDO_CMD lxc stop "$target" --force 2>/dev/null || true
        $SUDO_CMD lxc delete "$target" 2>/dev/null || true
        $SUDO_CMD lxc storage delete "${target}-pool" 2>/dev/null || true

        # Remove from config
        $SUDO_CMD python3 -c "
import json, os
cfg = '$CONFIG'
if os.path.exists(cfg):
    with open(cfg) as f:
        d = json.load(f)
    if '$target' in d.get('instances', {}):
        del d['instances']['$target']
    with open(cfg, 'w') as f:
        json.dump(d, f, indent=2)
" 2>/dev/null || true
        echo -e "${GREEN}[✓] Mini-VPS '$target' deleted successfully.${NC}"
    else
        echo "Aborted."
    fi
}

cmd_passwd() {
    local target="${1:-$(get_default_instance)}"
    local user="$2"
    local pass="$3"

    if [ -z "$user" ]; then
        read -rp "Enter username in '$target' [e.g. vpsadmin, root]: " user
    fi
    if [ -z "$pass" ]; then
        read -rp "Enter new password for '$user': " pass
    fi

    echo "$user:$pass" | $SUDO_CMD lxc exec "$target" -- chpasswd
    echo -e "${GREEN}[✓] Password for user '$user' in '$target' updated successfully.${NC}"
}

cmd_api() {
    local pub_ip
    pub_ip=$(get_config_val '.public_ip')
    if [ -z "$pub_ip" ]; then pub_ip=$(get_public_ip); fi
    local api_key
    api_key=$(get_config_val '.api_key')
    local api_port
    api_port=$(get_config_val '.api_port' || echo "8090")
    local def_target
    def_target=$(get_default_instance)

    echo -e "${CYAN}=================================================================${NC}"
    echo -e "${GREEN}${BOLD}                    MINI-VPS REST API GUIDE                      ${NC}"
    echo -e "${CYAN}=================================================================${NC}"
    echo -e " ${YELLOW}Base URL       :${NC} http://$pub_ip:$api_port"
    echo -e " ${YELLOW}Interactive Docs:${NC} http://$pub_ip:$api_port/docs"
    echo -e " ${YELLOW}API Key        :${NC} ${GREEN}$api_key${NC}"
    echo -e "${BLUE}-----------------------------------------------------------------${NC}"
    echo -e " ${MAGENTA}cURL Examples:${NC}"
    echo ""
    echo -e " 1. List all instances:"
    echo "    curl -H \"X-API-Key: $api_key\" http://$pub_ip:$api_port/api/vps/list"
    echo ""
    echo -e " 2. Get status of '$def_target':"
    echo "    curl -H \"X-API-Key: $api_key\" http://$pub_ip:$api_port/api/vps/$def_target/status"
    echo ""
    echo -e " 3. Restart '$def_target':"
    echo "    curl -X POST -H \"X-API-Key: $api_key\" http://$pub_ip:$api_port/api/vps/$def_target/restart"
    echo ""
    echo -e " 4. Execute command inside '$def_target':"
    echo "    curl -X POST -H \"X-API-Key: $api_key\" -H \"Content-Type: application/json\" \\"
    echo "         -d '{\"command\": \"uname -a; free -h\"}' \\"
    echo "         http://$pub_ip:$api_port/api/vps/$def_target/exec"
    echo ""
    echo -e " 5. Create a brand new Mini-VPS via API:"
    echo "    curl -X POST -H \"X-API-Key: $api_key\" -H \"Content-Type: application/json\" \\"
    echo "         -d '{\"name\":\"worker1\", \"cpu\":2, \"ram_gb\":4, \"storage_gb\":32, \"ssh_port\":2225, \"username\":\"admin\", \"password\":\"Pass123!\"}' \\"
    echo "         http://$pub_ip:$api_port/api/vps/create"
    echo -e "${CYAN}=================================================================${NC}"
}

cmd_menu() {
    while true; do
        clear
        show_header
        echo -e " ${YELLOW}[1]${NC}  Create New Mini-VPS ${GREEN}(Custom CPU, RAM, Disk, User, Pass)${NC}"
        echo -e " ${YELLOW}[2]${NC}  List All Mini-VPS Instances"
        echo -e " ${YELLOW}[3]${NC}  Mini-VPS Information & SSH Credentials"
        echo -e " ${YELLOW}[4]${NC}  Live Status & Resource Statistics ${GREEN}(RAM/CPU/Disk)${NC}"
        echo -e " ${YELLOW}[5]${NC}  1-Click Shell Login ${GREEN}(Direct Terminal Inside VPS)${NC}"
        echo -e "${BLUE}-----------------------------------------------------------------${NC}"
        echo -e " ${YELLOW}[6]${NC}  Start Mini-VPS"
        echo -e " ${YELLOW}[7]${NC}  Stop Mini-VPS"
        echo -e " ${YELLOW}[8]${NC}  Restart Mini-VPS"
        echo -e " ${YELLOW}[9]${NC}  Change User Password"
        echo -e " ${YELLOW}[10]${NC} Execute Command inside Mini-VPS"
        echo -e "${BLUE}-----------------------------------------------------------------${NC}"
        echo -e " ${YELLOW}[11]${NC} Show REST API Details & cURL Documentation"
        echo -e " ${YELLOW}[12]${NC} Delete Mini-VPS Instance & Free Storage"
        echo -e " ${YELLOW}[0]${NC}  Exit Menu"
        echo -e "${CYAN}=================================================================${NC}"
        read -rp " Select Option [0-12]: " opt

        case "$opt" in
            1)
                echo ""
                cmd_create
                read -rp " Press [Enter] to continue..."
                ;;
            2)
                echo ""
                cmd_list
                read -rp " Press [Enter] to continue..."
                ;;
            3)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_info "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            4)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_status "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            5)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_shell "${tname:-$(get_default_instance)}"
                ;;
            6)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_start "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            7)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_stop "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            8)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_restart "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            9)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                cmd_passwd "${tname:-$(get_default_instance)}"
                read -rp " Press [Enter] to continue..."
                ;;
            10)
                echo ""
                read -rp " Enter instance name [Default: $(get_default_instance)]: " tname
                read -rp " Enter command to run: " cmd_run
                $SUDO_CMD lxc exec "${tname:-$(get_default_instance)}" -- bash -c "$cmd_run"
                read -rp " Press [Enter] to continue..."
                ;;
            11)
                echo ""
                cmd_api
                read -rp " Press [Enter] to continue..."
                ;;
            12)
                echo ""
                cmd_delete
                read -rp " Press [Enter] to continue..."
                ;;
            0)
                echo ""
                echo -e "${GREEN}Thank you for using Mini-VPS Manager Suite!${NC}"
                break
                ;;
            *)
                echo -e "${RED}Invalid choice!${NC}"
                sleep 1
                ;;
        esac
    done
}

# Main routing
case "$1" in
    list|ls)
        cmd_list
        ;;
    create|add|new)
        shift
        cmd_create "$@"
        ;;
    info|show)
        cmd_info "$2"
        ;;
    status)
        cmd_status "$2"
        ;;
    shell|ssh|login)
        cmd_shell "$2"
        ;;
    start)
        cmd_start "$2"
        ;;
    stop)
        cmd_stop "$2"
        ;;
    restart|reboot)
        cmd_restart "$2"
        ;;
    delete|rm|destroy)
        cmd_delete "$2"
        ;;
    passwd|password)
        cmd_passwd "$2" "$3" "$4"
        ;;
    exec)
        shift
        target="${1:-$(get_default_instance)}"
        shift
        $SUDO_CMD lxc exec "$target" -- bash -c "$*"
        ;;
    api)
        cmd_api
        ;;
    menu)
        cmd_menu
        ;;
    version|-v|--version)
        echo "Mini-VPS Manager CLI v2.0.0"
        ;;
    help|-h|--help)
        echo "Usage: minivps [command] [args...]"
        echo ""
        echo "Commands:"
        echo "  menu                      Launch interactive management TUI"
        echo "  list                      List all active Mini-VPS instances"
        echo "  create [name] [os] [cpu] [ram] [disk] [port] [user] [pass]  Create custom VPS"
        echo "  info [name]               Show VPS specs, SSH command, API key"
        echo "  status [name]             Show live CPU, RAM, Disk usage and uptime"
        echo "  shell [name]              Instant 1-click shell into Mini-VPS"
        echo "  start [name]              Start Mini-VPS"
        echo "  stop [name]               Stop Mini-VPS"
        echo "  restart [name]            Restart Mini-VPS"
        echo "  passwd [name] [usr] [pwd] Update user password"
        echo "  exec [name] \"command\"     Execute command inside Mini-VPS"
        echo "  delete [name]             Delete Mini-VPS and free storage"
        echo "  api                       Display REST API guide and examples"
        ;;
    *)
        cmd_menu
        ;;
esac
